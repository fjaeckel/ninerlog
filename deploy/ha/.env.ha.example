# =============================================================================
# NinerLog — HA (two-region, active-passive) extra configuration
# =============================================================================
# These variables are ONLY needed when you run the HA overlays in deploy/ha/.
# Append the relevant block to each VM's existing .env. The base variables
# (POSTGRES_PASSWORD, JWT_SECRET, ...) from .env.example are still required on
# both VMs. See docs/HA_SCALING.md.
#
# Both VMs are on the same tailnet; replication and cross-region traffic ride
# Tailscale, so Postgres is never exposed on a public interface.
# -----------------------------------------------------------------------------

# --- Shared: the replication credentials (identical on BOTH VMs) -------------
# Create the role on the primary with scripts/pg-primary-setup.sh; the standby
# uses the same user/password/slot to stream.
REPLICATION_USER=replicator
REPLICATION_PASSWORD=            # [REQUIRED] Strong password; generate with: openssl rand -hex 24
REPLICATION_SLOT=standby_slot

# -----------------------------------------------------------------------------
# PRIMARY VM only  (docker-compose.primary.yml)
# -----------------------------------------------------------------------------
# The primary's OWN Tailscale IP. Postgres :5432 is published on THIS address
# only so the standby can reach it over the tailnet. Never set this to a public
# IP or 0.0.0.0.
PRIMARY_TAILSCALE_IP=            # [REQUIRED on primary] e.g. 100.101.102.103

# -----------------------------------------------------------------------------
# STANDBY VM only  (docker-compose.standby.yml)
# -----------------------------------------------------------------------------
# The PRIMARY's tailnet address, as seen from the standby (100.x IP or a
# Tailscale MagicDNS name). This is what pg_basebackup / walreceiver connect to.
PRIMARY_HOST=                    # [REQUIRED on standby] e.g. 100.101.102.103 or ninerlog-primary
PRIMARY_PORT=5432
